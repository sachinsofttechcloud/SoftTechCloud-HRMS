generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  role                Role                 @default(EMPLOYEE)
  department          String?
  designation         String?
  phone               String?
  avatar              String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  aadharCard          String?
  bloodGroup          String?
  panCard             String?
  passportPhoto       String?
  address             String?
  reportingManager    String?
  employeeId          String?              @unique @map("employee_id")
  joiningDate         DateTime             @default(now())
  birthDate           String?              @map("birth_date")
  probationStatus     String               @default("PROBATION")
  probationApprovedAt DateTime?
  attendances         Attendance[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  leaveRequests       LeaveRequest[]
  notifications       Notification[]
  hrDocument          HrDocument?
  compensation        Compensation?
  salarySlips         SalarySlip[]
  education           Education?
  bankDetail          BankDetail?
  moduleAccessGrants  UserModuleAccess[]   @relation("UserModuleAccessTarget")
  moduleAccessGranted UserModuleAccess[]   @relation("UserModuleAccessGrantedBy")
  assignedLeads       Lead[]               @relation("LeadAssignee")
  createdLeads        Lead[]               @relation("LeadCreator")
  leadActivities      LeadActivity[]

  @@map("users")
}

model AppModule {
  id          String             @id @default(uuid())
  key         String             @unique
  label       String
  description String?
  route       String?
  groupName   String?            @map("group_name")
  sortOrder   Int                @default(0) @map("sort_order")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  userAccess  UserModuleAccess[]

  @@map("app_modules")
}

model UserModuleAccess {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  moduleId    String    @map("module_id")
  canAccess   Boolean   @default(true) @map("can_access")
  grantedById String?   @map("granted_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation("UserModuleAccessTarget", fields: [userId], references: [id], onDelete: Cascade)
  module      AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  grantedBy   User?     @relation("UserModuleAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@map("user_module_access")
}

model LeaveRequest {
  id         String   @id @default(uuid())
  userId     String
  leaveType  String
  startDate  String
  endDate    String
  startTime  String?
  endTime    String?
  session    String   @default("FULL_DAY")
  totalDays  Float
  reason     String
  status     String   @default("PENDING")
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String?
  targetRoles String[]
  title       String
  message     String
  type        String   @default("GENERAL")
  relatedId   String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model HrDocument {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  employeeName    String   @map("employee_name")
  aadhaarCard     String?  @map("aadhaar_card")
  panCard         String?  @map("pan_card")
  joiningLetter   String?  @map("joining_letter")
  form16          String?  @map("form_16")
  probationLetter String?  @map("probation_letter")
  completed       String?  @map("completed")
  uploadedBy      String?  @map("uploaded_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hr_documents")
}

model Attendance {
  id              String           @id @default(uuid())
  userId          String
  date            String
  punchInTime     String?
  punchOutTime    String?
  totalHours      Float?
  workMode        WorkMode         @default(WFO)
  leaveType       LeaveType        @default(NONE)
  optionalHoliday String?
  capturedPhoto   String?
  status          AttendanceStatus @default(PRESENT)
  remarks         String?
  session         String?
  statusLabel     String?          @map("status_label")
  firstHalf       String?          @map("first_half")
  secondHalf      String?          @map("second_half")
  presentCredit   Float?           @default(0) @map("present_credit")
  leaveCredit     Float?           @default(0) @map("leave_credit")
  creditedHours   Float?           @default(0) @map("credited_hours")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("attendances")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Compensation {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  employeeId             String?  @map("employee_id")
  totalCtc               Float
  basicSalary            Float
  hra                    Float
  specialAllowance       Float
  variablePay            Float    @default(0)
  pfDeduction            Float
  employerPf             Float
  governmentTax          Float
  professionalTaxMonthly Float    @default(0)
  inHandCtc              Float
  monthlyInHand          Float
  monthlyGross           Float
  taxBracket             String
  taxNote                String?
  effectiveFrom          DateTime @default(now())
  notes                  String?
  createdBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("compensations")
}

model SalarySlip {
  id            String   @id @default(uuid())
  userId        String
  month         String
  monthLabel    String
  year          Int
  grossPay      Float
  pfDeduction   Float    @default(0)
  governmentTax Float    @default(0)
  netPay        Float
  status        String   @default("DISBURSED")
  fileUrl       String?
  fileData      String?  @map("file_data")
  fileName      String?  @map("file_name")
  generatedBy   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("salary_slips")
}

model Holiday {
  id        Int       @id @default(autoincrement())
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  dayLabel  String    @map("day_label")
  title     String
  type      String
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("holidays")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  LEAVE
  HOLIDAY
  WEEKEND
  WFH
  ON_FIELD
}

enum WorkMode {
  WFO
  WFH
  ON_FIELD
}

model Education {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  employeeId    String?  @map("employee_id")
  degree        String
  instituteName String   @map("institute_name")
  passingYear   String   @map("passing_year")
  certificate   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("educations")
}

model BankDetail {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  employeeId    String?  @map("employee_id")
  accountNumber String   @map("account_number")
  accountType   String   @map("account_type")
  ifscCode      String   @map("ifsc_code")
  branchName    String   @map("branch_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("bank_details")
}

enum LeaveType {
  NONE
  CASUAL
  SICK
  EMERGENCY
}

model Exam {
  id                     Int           @id @default(autoincrement())
  candidateName          String        @map("candidate_name")
  technology             String
  examName               String        @map("exam_name")
  mobileNo               String        @map("mobile_no")
  mode                   String        @default("ONLINE")
  centerName             String?       @map("center_name")
  examDate               DateTime      @map("exam_date") @db.Date
  examTime               String        @map("exam_time")
  voucher                Boolean       @default(false)
  assistSupport          Boolean       @default(true) @map("assist_support")
  paymentStatus          String        @default("PENDING") @map("payment_status")
  lifecycleStatus        String        @default("SCHEDULED") @map("lifecycle_status")
  cancelledAt            DateTime?     @map("cancelled_at")
  reminderSentAt         DateTime?     @map("reminder_sent_at")
  oneHourReminderSentAt  DateTime?     @map("one_hour_reminder_sent_at")
  sevenDayReminderSentAt DateTime?     @map("seven_day_reminder_sent_at")
  threeDayReminderSentAt DateTime?     @map("three_day_reminder_sent_at")
  twoHourReminderSentAt  DateTime?     @map("two_hour_reminder_sent_at")
  attended               Boolean?
  aadharCard             String?       @map("aadhar_card")
  documentStatus         String        @default("PENDING") @map("document_status")
  confirmationStatus     String        @default("PENDING") @map("confirmation_status")
  voucherStatus          String        @default("PENDING") @map("voucher_status")
  voucherExpiryAt        DateTime?     @map("voucher_expiry_at") @db.Date
  candidateId            String?       @map("candidate_id")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  candidate              Candidate?    @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  supportCases           SupportCase[]

  @@index([candidateId])
  @@map("exams")
}

model Candidate {
  id               String    @id @default(uuid())
  candidateCode    String    @unique @map("candidate_code")
  fullLegalName    String    @map("full_legal_name")
  mobileNumber     String    @unique @map("mobile_number")
  whatsappNumber   String?   @map("whatsapp_number")
  email            String?
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  address          String?
  identityDocument String?   @map("identity_document")
  providerIds      Json?     @map("provider_ids")
  companyName      String?   @map("company_name")
  collegeName      String?   @map("college_name")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  leads            Lead[]
  exams            Exam[]

  @@index([email])
  @@map("candidates")
}

model Lead {
  id                    String             @id @default(uuid())
  leadCode              String             @unique @map("lead_code")
  candidateId           String?            @map("candidate_id")
  fullName              String             @map("full_name")
  mobileNumber          String             @map("mobile_number")
  whatsappNumber        String             @map("whatsapp_number")
  email                 String?
  technology            String
  examName              String             @map("exam_name")
  examCode              String             @map("exam_code")
  mode                  String
  preferredDate         DateTime           @map("preferred_date") @db.Date
  preferredTime         String             @map("preferred_time")
  voucherNeed           Boolean            @default(false) @map("voucher_need")
  quotedFee             Decimal            @map("quoted_fee") @db.Decimal(12, 2)
  companyReimbursement  Boolean            @default(false) @map("company_reimbursement")
  companyName           String?            @map("company_name")
  source                String
  campaign              String?
  assignedEmployeeId    String             @map("assigned_employee_id")
  status                String             @default("ACTIVE")
  stage                 String             @default("NEW")
  priority              String             @default("MEDIUM")
  lastContactAt         DateTime?          @map("last_contact_at")
  nextActionAt          DateTime           @map("next_action_at")
  nextAction            String             @map("next_action")
  remarks               String?
  lostReason            String?            @map("lost_reason")
  convertedAt           DateTime?          @map("converted_at")
  overdueEscalatedAt    DateTime?          @map("overdue_escalated_at")
  paymentReminderSentAt DateTime?          @map("payment_reminder_sent_at")
  createdById           String             @map("created_by_id")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  candidate             Candidate?         @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  assignedEmployee      User               @relation("LeadAssignee", fields: [assignedEmployeeId], references: [id])
  createdBy             User               @relation("LeadCreator", fields: [createdById], references: [id])
  activities            LeadActivity[]
  paymentAction         LeadPaymentAction?
  supportCases          SupportCase[]

  @@index([mobileNumber])
  @@index([email])
  @@index([companyName])
  @@index([stage])
  @@index([assignedEmployeeId])
  @@index([nextActionAt])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  userId    String?  @map("user_id")
  type      String
  title     String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model LeadPaymentAction {
  id                  String    @id @default(uuid())
  leadId              String    @unique @map("lead_id")
  amountDue           Decimal   @map("amount_due") @db.Decimal(12, 2)
  amountPaid          Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  commitmentDate      DateTime? @map("commitment_date") @db.Date
  channel             String    @default("Direct")
  verificationStatus  String    @default("PENDING") @map("verification_status")
  reimbursementStatus String    @default("NOT_REQUIRED") @map("reimbursement_status")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([commitmentDate])
  @@map("lead_payment_actions")
}

model DashboardMaintenance {
  id        String   @id @default(uuid())
  title     String
  type      String
  due       DateTime @db.Date
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([due])
  @@map("dashboard_maintenance")
}

model DashboardReminder {
  id        String   @id @default(uuid())
  title     String
  type      String
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("dashboard_reminders")
}

model SupportCase {
  id            String   @id @default(uuid())
  caseCode      String   @unique @map("case_code")
  candidateName String   @map("candidate_name")
  type          String
  status        String   @default("OPEN")
  opened        DateTime @default(now()) @db.Date
  owner         String
  leadId        String?  @map("lead_id")
  examId        Int?     @map("exam_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  exam          Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([examId])
  @@index([status])
  @@map("support_cases")
}

model MonthlyRevenue {
  id                String   @id @default(uuid())
  month             DateTime @unique @db.Date
  supportCostActual Decimal  @default(0) @map("support_cost_actual") @db.Decimal(14, 2)
  voucherCost       Decimal  @default(0) @map("voucher_cost") @db.Decimal(14, 2)
  supportSetupCost  Decimal  @default(0) @map("support_setup_cost") @db.Decimal(14, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("monthly_revenue")
}
